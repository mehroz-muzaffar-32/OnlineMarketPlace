<a href="#" class="flex flex-row align-stretch bg-gray-100 rounded-lg shadow hover:bg-gray-200 border-gray-700 mx-1 h-full min-w-[75%]">
    <div class='h-full w-[30%]'>
        <img class="object-cover h-full w-full rounded-s-lg" src="@product.Base64Img" alt="" />
    </div>
    <div class="flex flex-col justify-between p-4 leading-normal flex-1">
        <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900" >@product.Name</h5>
        <div class="flex justify-between items-center">
            <div class='h-10 w-10'><img src="shop" class='rounded-lg object-cover h-full w-full'/></div>
            <p class='truncate text-left flex-1 ml-1'>Carrefour</p>
        </div>
        <p class="mb-3 font-normal text-gray-700" >@product.Description</p>
    </div>
</a>

@code {
    [Parameter]
    public Product product { get; set; }
}
